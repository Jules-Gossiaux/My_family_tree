# Copier ce fichier vers `.env.local` et renseigner les valeurs du projet Supabase.
# Seule la clé "anon" (publique) doit apparaître ici : jamais la clé "service_role".
# Ces deux valeurs sont obligatoires : l'arbre fonctionne uniquement en ligne.

VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLIQUE
